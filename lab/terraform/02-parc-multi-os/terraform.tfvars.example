pve_api_token = "terraform@pve!tf=12345678-90ab-cdef-1234-567890abcdef"

ssh_public_key = "ssh-ed25519 AAAAC3Nza... eleve@formation"

# Nom du nœud : « pve » par défaut (jours 1-3). En cluster : pve1 … pve6.
# pve_node = "pve3"

# Récupérez le nom exact avec :  pveam list local
lxc_template_alpine = "local:vztmpl/alpine-3.22-default_20250617_amd64.tar.xz"

# Pour surcharger les VMID des templates (190/191/192 par défaut, cf. TP 10) :
