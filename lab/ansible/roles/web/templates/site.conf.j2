# Généré par Ansible — rôle « web ». Ne pas modifier à la main.
server {
    listen {{ web_listen_port }} default_server;
    server_name _;

    root {{ web_root }};
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
{% if web_upstream %}

    # Reverse-proxy vers l'application interne
    location /app/ {
        proxy_pass http://{{ web_upstream }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
{% endif %}
}
