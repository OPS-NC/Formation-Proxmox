# /etc/pve/sdn/firewall/vdmz.fw   —   zone DMZ (régime strict)
#
# Principe : une machine exposée est une machine PRÉSUMÉE COMPROMISE.
# DMZ → INTERNE = zéro, et on le journalise en warning.
#
# ⭐ PORTÉE RÉELLE DE CE FICHIER — à lire avant de débugger pendant une heure :
#   un fichier .fw de VNet ne filtre QUE le trafic intra-VNet (guest ↔ guest) et
#   le trafic VNet ↔ hôte (DNS/DHCP/ping vers la gateway). Dès qu'un paquet SORT
#   du VNet — autre VNet, ou Internet — il est ROUTÉ par l'hôte et ne traverse
#   plus cette chaîne : il faut une règle FORWARD dans cluster.fw / host.fw.
#   Les règles ci-dessous en gardent une trace (défense en profondeur), mais
#   elles ne suffisent PAS à elles seules. Voir TP 09 §5.4.

[OPTIONS]

enable: 1
policy_forward: DROP

[RULES]

# ── DHCP : la ligne que personne n'écrit 🪤 ───────────────────────────────────
# Le DISCOVER part de 0.0.0.0 vers 255.255.255.255 : AUCUN IPSet SDN ne peut le
# matcher. L'OFFER de dnsmasq repart de la gateway vers le guest. Sans cette
# règle, le drop final de la chaîne tue les deux, et un guest redémarré ne
# récupère plus jamais d'IP (dnsmasq : « Error sending DHCP packet … Operation
# not permitted »).
FORWARD ACCEPT -p udp -dport 67:68 -log nolog

# ── Services d'infrastructure ────────────────────────────────────────────────
FORWARD ACCEPT -source +sdn/vdmz-all -dest +sdn/vdmz-gateway -p udp -dport 53 -log nolog
FORWARD ACCEPT -source +sdn/vdmz-all -dest +sdn/vdmz-gateway -p tcp -dport 53 -log nolog
FORWARD ACCEPT -source +sdn/vdmz-all -dest +sdn/vdmz-gateway -p icmp -log nolog

# ── Entre machines de la DMZ : web uniquement ────────────────────────────────
FORWARD ACCEPT -source +sdn/vdmz-all -dest +sdn/vdmz-all -p tcp -dport 80 -log nolog
FORWARD ACCEPT -source +sdn/vdmz-all -dest +sdn/vdmz-all -p tcp -dport 443 -log nolog

# ── Flux entrants depuis l'interne (le retour est géré par le conntrack) ─────
FORWARD ACCEPT -source +sdn/vint-all -dest +sdn/vdmz-all -p tcp -dport 22 -log nolog
FORWARD ACCEPT -source +sdn/vint-all -dest +sdn/vdmz-all -p tcp -dport 80 -log nolog
FORWARD ACCEPT -source +sdn/vint-all -dest +sdn/vdmz-all -p tcp -dport 443 -log nolog

# ── Supervision : la zone SERVICES scrape la DMZ (ajouté au TP 12) ──────────
# ⚠ Le pendant de la règle « vsrv → vdmz:9100 » de vsrv.fw. Une règle FORWARD
#   est unidirectionnelle et le paquet traverse les DEUX VNets : il faut
#   l'autoriser des deux côtés.
FORWARD ACCEPT -source +sdn/vsrv-all -dest +sdn/vdmz-all -p tcp -dport 9100 -log nolog

# ── 🚨 DMZ vers INTERNE : INTERDIT (avant les règles Internet !) ─────────────
FORWARD DROP -source +sdn/vdmz-all -dest +sdn/vint-all -log warning
FORWARD DROP -source +sdn/vdmz-all -dest +sdn/vsrv-all -log warning

# ── DMZ vers Internet : mises à jour uniquement ──────────────────────────────
# ⚠ Idem : le pendant FORWARD dans cluster.fw est indispensable.
FORWARD ACCEPT -source +sdn/vdmz-all -p tcp -dport 80 -log nolog
FORWARD ACCEPT -source +sdn/vdmz-all -p tcp -dport 443 -log nolog
FORWARD ACCEPT -source +sdn/vdmz-all -p udp -dport 53 -log nolog
FORWARD ACCEPT -source +sdn/vdmz-all -p udp -dport 123 -log nolog
