# /etc/pve/nodes/<nodename>/host.fw
#
# ⭐ « nftables: 1 » est INDISPENSABLE : sans lui, les règles au niveau VNet
#    (/etc/pve/sdn/firewall/*.fw) sont IGNORÉES SILENCIEUSEMENT.
#    Après activation, redémarrez les VM et CT.

[OPTIONS]

enable: 1
nftables: 1
log_level_in: nolog
log_level_out: nolog
log_level_forward: info
tcpflags: 1
nosmurfs: 1
protection_synflood: 1
protection_synflood_rate: 200
protection_synflood_burst: 1000

[RULES]

# Règles spécifiques à CE nœud uniquement.
# Exemple : autoriser un collecteur de métriques
# IN ACCEPT -source 172.30.30.42 -p tcp -dport 9100 -log nolog
