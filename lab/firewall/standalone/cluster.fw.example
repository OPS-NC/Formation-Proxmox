# /etc/pve/firewall/cluster.fw — STANDALONE, TP 09 (pas le cluster des TP 16+)
# ─────────────────────────────────────────────────────────────────────────────
# ⚠ ORDRE DE MISE EN PLACE
#   1. écrire les règles [RULES] d'autorisation
#   2. SEULEMENT ENSUITE passer policy_in / policy_forward en DROP
#   Sinon vous perdez l'accès à :8006 et il faut un clavier sur le serveur.
#
# ⭐ C'EST ICI QUE VIT LA SEGMENTATION INTER-ZONES, pas dans les .fw de VNet.
#   Un paquet qui SORT de son VNet (vers un autre VNet ou vers Internet) est
#   ROUTÉ par l'hôte : il traverse le hook « forward », où seules les règles
#   FORWARD du Datacenter et du nœud sont évaluées. Les fichiers
#   /etc/pve/sdn/firewall/<vnet>.fw ne voient que le trafic INTRA-VNet et
#   VNet ↔ hôte.  Détail et démonstration : TP 09 §5.4.
# ─────────────────────────────────────────────────────────────────────────────

[OPTIONS]

enable: 1
policy_in: DROP
policy_out: ACCEPT
policy_forward: DROP
log_ratelimit: enable=1,rate=5/second,burst=20

[ALIASES]

lan_salle 172.30.30.0/24   # LAN physique de la salle
gw_salle 172.30.30.2       # routeur / accès Internet
net_internal 10.10.10.0/24 # zone interne (TP 08)
net_dmz 10.10.20.0/24      # DMZ (TP 08)
net_services 10.10.30.0/24 # zone services (TP 12)

[IPSET management]               # tout ce qui peut administrer les nœuds

172.30.30.0/24

[group pve-admin]                # accès à l'administration Proxmox

IN ACCEPT -source +management -p tcp -dport 8006 -log nolog # interface web
IN ACCEPT -source +management -p tcp -dport 22 -log nolog # SSH
IN ACCEPT -source +management -p tcp -dport 3128 -log nolog # proxy SPICE
IN ACCEPT -source +management -p tcp -dport 5900:5999 -log nolog # consoles VNC

[group srv-web]                  # un serveur web générique

IN ACCEPT -p tcp -dport 80 -log nolog
IN ACCEPT -p tcp -dport 443 -log nolog

[group srv-db]                   # une base, ouverte à l'interne seulement

IN ACCEPT -source +sdn/vint-all -p tcp -dport 5432 -log nolog
IN ACCEPT -source +sdn/vint-all -p tcp -dport 3306 -log nolog

[RULES]

# ── Administration ───────────────────────────────────────────────────────────
IN ACCEPT -source +management -p tcp -dport 8006 -log nolog # UI Proxmox
IN ACCEPT -source +management -p tcp -dport 22 -log nolog # SSH
IN ACCEPT -source +management -p tcp -dport 3128 -log nolog # SPICE
IN ACCEPT -source +management -p tcp -dport 5900:5999 -log nolog # noVNC

# ── Stockage et sauvegarde ───────────────────────────────────────────────────
# 🧠 Rien à ouvrir en entrée pour le NFS : c'est le NŒUD qui initie la connexion
#    vers le port 2049 de votre poste. Le conntrack gère le retour. La règle
#    « IN ACCEPT -source <nfs> -dport 2049 » qu'on voit partout est inutile —
#    et révèle une confusion entre client et serveur.
IN ACCEPT -source lan_salle -p tcp -dport 8007 -log nolog # UI PBS

# ── Diagnostic ───────────────────────────────────────────────────────────────
IN ACCEPT -source lan_salle -p icmp -log nolog

# ── Services d'infrastructure portés par le nœud (gateway des VNets) ─────────
# 🧠 policy_in: DROP s'applique AUSSI aux VM : la gateway d'un subnet SDN est une
#    IP de l'hôte. Sans ces lignes, plus de DNS ni de ping vers la gateway — et
#    les règles de vint.fw / vdmz.fw n'y changent rien.
# 🪤 Le DHCP part de 0.0.0.0 : aucun IPSet SDN ne peut le matcher, d'où le filtre
#    par interface. Sans ça, un guest redémarré ne récupère plus d'IP.
IN ACCEPT -i vint -p udp -dport 67 -log nolog # DHCP vint
IN ACCEPT -i vdmz -p udp -dport 67 -log nolog # DHCP vdmz
IN ACCEPT -source +sdn/vint-all -p udp -dport 53 -log nolog # DNS depuis vint
IN ACCEPT -source +sdn/vint-all -p tcp -dport 53 -log nolog
IN ACCEPT -source +sdn/vint-all -p icmp -log nolog # ping de la gateway
IN ACCEPT -source +sdn/vdmz-all -p udp -dport 53 -log nolog # DNS depuis vdmz
IN ACCEPT -source +sdn/vdmz-all -p tcp -dport 53 -log nolog
IN ACCEPT -source +sdn/vdmz-all -p icmp -log nolog


# ── ⭐ Depuis le poste vers TOUS les réseaux privés : SSH, HTTP, PostgreSQL, ping ──
# Le PC route vers les VNets via le nœud (ip route add 10.10.0.0/16 via $PVE, TP 07).
# Ce trafic TRAVERSE le nœud : sans ces règles, policy_forward: DROP le jette, et
# Ansible (TP 13) comme vos « ssh eleve@10.10.x.y » ne passent plus.
# Une règle par réseau et par flux. Les alias des subnets futurs ne sont pas des IPSets.
# Ces flux sont ROUTÉS (LAN → VNet) : c'est ici qu'ils se décident, pas dans les .fw de VNet.
FORWARD ACCEPT -source lan_salle -dest net_internal -p tcp -dport 22 -log nolog # SSH
FORWARD ACCEPT -source lan_salle -dest net_internal -p tcp -dport 80 -log nolog # HTTP
FORWARD ACCEPT -source lan_salle -dest net_internal -p tcp -dport 5432 -log nolog # PostgreSQL
FORWARD ACCEPT -source lan_salle -dest net_internal -p icmp -log nolog # ping
FORWARD ACCEPT -source lan_salle -dest net_dmz -p tcp -dport 22 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_dmz -p tcp -dport 80 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_dmz -p tcp -dport 5432 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_dmz -p icmp -log nolog
FORWARD ACCEPT -source lan_salle -dest net_services -p tcp -dport 22 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_services -p tcp -dport 80 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_services -p tcp -dport 5432 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_services -p icmp -log nolog

# Accès web TLS aux réseaux du lab et interfaces de supervision depuis le LAN.
FORWARD ACCEPT -source lan_salle -dest net_internal -p tcp -dport 443 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_dmz -p tcp -dport 443 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_services -p tcp -dport 443 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_services -p tcp -dport 3000 -log nolog
FORWARD ACCEPT -source lan_salle -dest net_services -p tcp -dport 9090 -log nolog

# ── Zone HOST : le trafic ROUTÉ par le nœud ⭐ ────────────────────────────────
# C'est la traduction directe de la matrice de flux du TP 09 §1.
# Même règle d'or qu'ailleurs : les DROP explicites AVANT les règles fourre-tout
# sans -dest, sinon celles-ci attrapent aussi le trafic inter-zones.
FORWARD ACCEPT -source +sdn/vint-all -dest +sdn/vdmz-all -p tcp -dport 22 -log nolog # int->dmz SSH
FORWARD ACCEPT -source +sdn/vint-all -dest +sdn/vdmz-all -p tcp -dport 80 -log nolog
FORWARD ACCEPT -source +sdn/vint-all -dest +sdn/vdmz-all -p tcp -dport 443 -log nolog
FORWARD ACCEPT -source +sdn/vint-all -dest +sdn/vdmz-all -p icmp -log nolog
FORWARD DROP -source +sdn/vint-all -dest +sdn/vdmz-all -log info # tout autre int->dmz
FORWARD DROP -source +sdn/vdmz-all -dest +sdn/vint-all -log warning # 🚨 DMZ -> INTERNE
# Le réseau SERVICES sera ouvert finement par Terraform au TP 12.
FORWARD DROP -source +sdn/vint-all -dest net_services -log info
FORWARD DROP -source +sdn/vdmz-all -dest net_services -log warning
FORWARD ACCEPT -source +sdn/vint-all -log nolog # interne -> Internet, libre
FORWARD ACCEPT -source +sdn/vdmz-all -p tcp -dport 80 -log nolog # dmz -> Internet
FORWARD ACCEPT -source +sdn/vdmz-all -p tcp -dport 443 -log nolog
FORWARD ACCEPT -source +sdn/vdmz-all -p udp -dport 53 -log nolog
FORWARD ACCEPT -source +sdn/vdmz-all -p udp -dport 123 -log nolog # NTP

FORWARD ACCEPT -source +sdn/vdmz-all -p tcp -dport 53 -log nolog # DNS TCP
